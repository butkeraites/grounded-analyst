# ---------------------------------------------------------------------------
# Local-first defaults. `cp .env.example .env` and `docker compose up` works
# as-is: every value below points at a container in docker-compose.yml.
# Hosted vendors (Neon, Upstash, PostHog Cloud, an LLM API) are deploy-time
# swaps of these strings — nothing in the app hard-codes a provider.
# ---------------------------------------------------------------------------

# Postgres — the `postgres` service. Host `postgres` resolves on the compose network.
DATABASE_URL=postgres://grounded:grounded@postgres:5432/grounded

# Redis — the `redis` service.
REDIS_URL=redis://redis:6379

# Host port the web app is published on. Change if 3000 is already taken.
WEB_PORT=3000

# --- Deferred (see plan / future ADR). Left unset on purpose in milestone 1. ---

# Bring-your-own-LLM: the deployment DEFAULT. The interface + config seam exist;
# no adapter is wired yet. A caller (UI setting / MCP `ask` arg) can override
# any of these per-request. `openai-compatible` covers OpenAI, Ollama, LM
# Studio, vLLM, Groq, Together, … — point LLM_BASE_URL at their /v1 endpoint.
#
# Fully-local example (Ollama container, no key needed):
#   LLM_KIND=openai-compatible
#   LLM_BASE_URL=http://ollama:11434/v1
#   LLM_MODEL=qwen2.5-coder
#
# LLM_KIND=openai-compatible
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=

# PostHog. Local uses a no-op analytics wrapper; set these only to point at a
# real instance later.
# POSTHOG_KEY=
# POSTHOG_HOST=
