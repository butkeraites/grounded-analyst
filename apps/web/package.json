{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "cd ../.. && npm run build:core && (npm run db:migrate --workspace @grounded/core || echo '[build] migrate skipped/failed — non-fatal') && cd apps/web && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"lib/**/*.test.ts\""
  },
  "dependencies": {
    "@grounded/core": "*",
    "@upstash/ratelimit": "^2.1.0",
    "@upstash/redis": "^1.38.4",
    "ioredis": "^6.0.0",
    "next": "^16.3.5",
    "pg": "^8.13.1",
    "posthog-node": "^5.52.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "simple-icons": "^16.31.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.10.0",
    "eslint-config-next": "^16.3.5",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
