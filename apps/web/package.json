{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "cd ../.. && npm run build:core && (npm run db:migrate --workspace @julius/core || echo '[build] migrate skipped/failed — non-fatal') && cd apps/web && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"lib/**/*.test.ts\""
  },
  "dependencies": {
    "@julius/core": "*",
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.34.3",
    "ioredis": "^6.0.0",
    "next": "^16.3.3",
    "pg": "^8.13.1",
    "posthog-node": "^5.51.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.9.1",
    "eslint-config-next": "^16.3.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2"
  }
}
